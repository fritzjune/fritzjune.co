# Copy to .env.local for local dev, and add the same variable in Vercel > Project > Settings > Environment Variables
MAKE_WEBHOOK_URL=https://hook.us2.make.com/your-webhook-id

# Visitor pop-ups (optional). Add "Upstash for Redis" from the Vercel Marketplace and these two are filled in for you.
# Leave them out and the pop-ups stay off (nothing is faked).
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Optional: any long random string, used to hash visitor IPs for de-duplication (defaults to the KV token)
ACTIVITY_SALT=
